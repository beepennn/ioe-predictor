{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/data/(.*)", "dest": "/public/data/$1" },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
    { "src": "/logo.svg", "dest": "/public/logo.svg" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}